{
  "name": "web-docs",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.solarianetwork.site",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  }
}
